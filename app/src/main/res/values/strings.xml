    <!-- Lazy Grid Practice -->
    <string name="lazy_grid_practice_title">Lazy Grid Practice</string>
    <string name="lazy_grid_practice_desc">Bu uygulamada; LazyVerticalGrid (Adaptive, maxLineSpan ile 5\'in katları tam satır) ve LazyHorizontalGrid (Fixed(3) satır, yatay kaydırma) yapılarını öğrendik.</string>

    <!-- Lazy List State Practice -->
    <string name="lazy_list_state_practice_title">Lazy List State Control</string>
    <string name="lazy_list_state_practice_desc">Bu uygulamada; LazyListState ile belirli bir indekse anında (scrollToItem) veya animasyonlu (animateScrollToItem) kaydırma ve visibleItemsInfo ile görünür öğe sayısını izlemeyi öğrendik.</string>

    <!-- Advanced Lazy Lists -->
    <string name="advanced_lazy_lists_practice_title">Advanced Lazy Lists</string>
    <string name="advanced_lazy_lists_practice_desc">Bu uygulamada; LazyRow ile yatay filtre çubuğu (spacedBy, contentPadding) ve tek bir LazyColumn içinde header, items ve footer (Rapor Sonu) birleştirmeyi öğrendik.</string>

    <!-- Order History -->
    <string name="order_history_title">Order History</string>
    <string name="order_history_desc">Bu uygulamada; sealed interface (OrderFeedItem), key ve contentType parametreleriyle çoklu görünüm tipli (SummaryCard, ActiveOrder, PromotionBanner) LazyColumn performans optimizasyonunu öğrendik.</string>

    <!-- Dynamic List Animations -->
    <string name="dynamic_animations_title">Dynamic List Animations</string>
