    <!-- Educational App Descriptions & Categories -->
    <string name="dice_roller_desc">Bu uygulamada; remember ve mutableStateOf ile Compose\'da durum yönetimini (State), Random ile rastgele veri üretimini ve dinamik görsel (Drawable) güncellemelerini öğrendik.</string>
    <string name="category_basit_ui">State &amp; UI</string>

    <string name="lemonade_desc">Bu uygulamada; çok aşamalı kullanıcı akışlarını yönetmek için State Machine mantığını, koşullu UI render etmeyi ve tıklama sayaçları ile state güncellemelerini öğrendik.</string>
    <string name="category_state_machine">State Machine</string>

    <string name="tip_calc_desc">Bu uygulamada; OutlinedTextField ile kullanıcıdan sayısal girdi almayı, KeyboardOptions ile klavye yönetimini ve NumberFormat ile para birimi formatlamayı öğrendik.</string>
    <string name="category_forms">Forms &amp; Input</string>

